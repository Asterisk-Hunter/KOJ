# KOJ FastAPI judge service — copy to .env, fill in real values.
# NEVER commit .env (it is gitignored).

# Database (Neon Postgres — use pooled connection string)
DATABASE_URL=

# Bind address and port (Cloud Run sets PORT automatically)
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Shared secret for POST /judge (must match Next.js JUDGE_INTERNAL_SECRET)
JUDGE_INTERNAL_SECRET=

# Production frontend origin for CORS (e.g. https://koj.vercel.app)
FRONTEND_URL=
