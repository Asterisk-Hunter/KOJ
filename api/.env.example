# KOJ FastAPI judge service — copy to .env, fill in real values.
# NEVER commit .env (it is gitignored).

# Database (Neon Postgres — use pooled connection string)
DATABASE_URL=
DATABASE_TLS_VERIFY=true

# Bind address and port (Cloud Run sets PORT automatically)
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Shared secret for POST /judge (must match Next.js JUDGE_INTERNAL_SECRET)
JUDGE_INTERNAL_SECRET=

# Dedicated secret for headless offline-model evaluation. Leave empty to
# disable the private research endpoints. Do not share it with the judge VM.
TRAINING_API_SECRET=
# Required with TRAINING_API_SECRET: Cloud Run service URL used as OIDC audience.
TRAINING_OIDC_AUDIENCE=
# Required with TRAINING_API_SECRET: GPU VM service-account email.
TRAINING_OIDC_PRINCIPAL=
# Explicitly enable research queue consumption only on the isolated Docker worker.
TRAINING_WORKER_ENABLED=false
# Required when TRAINING_API_SECRET or TRAINING_WORKER_ENABLED is enabled.
TRAINING_ORGANIZATION_ID=
TRAINING_MAX_BODY_BYTES=2097152
TRAINING_MAX_ACTIVE_SAMPLES=128
TRAINING_DAILY_SAMPLE_LIMIT=3000
TRAINING_MAX_RETAINED_SAMPLES=100000
TRAINING_LEASE_SECONDS=180

# Optional trusted isolated judge VM origin. Cloud Run must set this; plain
# HTTP is accepted only for the private 10.32.0.0/24 subnet. Use HTTPS elsewhere.
JUDGE_UPSTREAM_URL=

# Direct HTTP execution is for an explicitly configured non-Cloud-Run Docker VM
# or local development. Cloud Run never executes submissions in the API process.
JUDGE_HTTP_EXECUTION_ENABLED=false

# Production frontend origin for CORS (e.g. https://koj.vercel.app)
FRONTEND_URL=

# Max judge request body in bytes (both /judge and /judge-async -> 413)
MAX_JUDGE_BODY_BYTES=262144

# Sandbox backend:
#   auto   (default) Docker or Cloud Run launcher, otherwise fails closed
#   docker           container sandbox only (fails closed without a daemon)
#   cloudrun         experimental Cloud Run sandbox launcher; blocked by live rootfs probes
#   rlimit           host toolchain limits; local trusted development only
# Public hostile submissions require a verified Docker/cgroup judge host.
JUDGE_SANDBOX_MODE=docker

# FastAPI OpenAPI/Swagger/ReDoc endpoints are disabled by default.
API_EXPOSE_DOCS=false

# Docker-only sandbox images (server-side allow-list, never user-controlled).
# Pre-pull on the judge host: docker pull <each image>.
JUDGE_DOCKER_IMAGE_PYTHON=python:3.11-slim
JUDGE_DOCKER_IMAGE_GCC=gcc:13-bookworm
JUDGE_DOCKER_IMAGE_JAVA=eclipse-temurin:17-jdk-jammy

# Sandbox limits (fixed flags, not user-controlled).
JUDGE_DOCKER_CPUS=1.0
JUDGE_DOCKER_PIDS_LIMIT=64
JUDGE_DOCKER_USER=65534:65534

# Max concurrent direct /judge requests per API process (1..32).
JUDGE_MAX_CONCURRENT=1

# Postgres worker lease and idle queue polling.
JUDGE_LEASE_SECONDS=120
JUDGE_WORKER_POLL_SECONDS=1.0

# Docker daemon host path to the repo-managed seccomp profile.
# Provision: copy api/seccomp-koj.json to this host path on the judge
# host. Missing/invalid profile fails closed (no host fallback).
JUDGE_SECCOMP_PROFILE=/etc/koj/seccomp-koj.json
