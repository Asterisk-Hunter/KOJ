[Unit]
Description=KOJ private judge compatibility API
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=koj
Group=koj
SupplementaryGroups=docker
WorkingDirectory=/opt/koj/source/api
EnvironmentFile=/etc/koj/api.env
Environment=TMPDIR=/var/lib/koj
ExecStart=/opt/koj/venv/bin/uvicorn app.main:app --host ${FASTAPI_HOST} --port ${FASTAPI_PORT} --workers 1
Restart=on-failure
RestartSec=3
TimeoutStopSec=150
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/koj
MemoryMax=512M
CPUQuota=100%
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
