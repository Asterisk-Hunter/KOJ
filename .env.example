# KOJ Next.js frontend — copy to .env.local, fill in real values.
# NEVER commit .env.local (it is gitignored).

# Database (Neon Postgres — use pooled connection string)
DATABASE_URL=

# FastAPI judge service origin (e.g. https://koj-judge-xxxxxx.a.run.app)
FASTAPI_URL=

# Shared secret for POST /judge (must match FastAPI JUDGE_INTERNAL_SECRET)
JUDGE_INTERNAL_SECRET=

# Clerk — publishable + secret keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk — sign-in / sign-up paths (defaults shown)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Clerk webhook signing secret (whsec_...) — needed for /api/webhooks/clerk
CLERK_WEBHOOK_SECRET=
